APP_NAME=Nova Assistant Backend
ENVIRONMENT=development
DEBUG=false

POSTGRES_USER=nova
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nova
DATABASE_URL=postgresql+asyncpg://nova:change-me@postgres:5432/nova
DATABASE_URL_SYNC=postgresql+psycopg://nova:change-me@postgres:5432/nova
REDIS_URL=redis://redis:6379/0

JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ISSUER=nova-backapp
JWT_USER_AUDIENCE=nova-user
JWT_DEVICE_AUDIENCE=nova-device
ACCESS_TOKEN_TTL_SECONDS=900

FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_JSON=
FCM_ENABLED=true

CORS_ORIGINS=https://localhost,http://localhost:5173
DOCS_ENABLED=true
RATE_LIMIT_PER_MINUTE=10
SYNC_DEFAULT_LIMIT=100
SYNC_MAX_LIMIT=500
SCHEDULER_TIMEZONE=UTC

NOVA_DOMAIN=localhost
